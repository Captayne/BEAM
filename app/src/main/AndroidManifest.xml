<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet für BitTorrent/DHT -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground Service für Seeding im Hintergrund -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Verhindert dass Android den Service schläft -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Nutzer kann Beam von der Akku-Optimierung ausnehmen (sonst Drosselung im Hintergrund) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- WLAN-Status lesen + Multicast-Lock für LSD (lokale Peer-Discovery im selben WLAN/Hotspot) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Notification-Anzeige ab Android 13 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Empfangene Dateien in öffentliche Ordner schreiben (nur API < 29; ab 29 via MediaStore) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Chronologie-Modus: Bilder/Videos der Zeitspanne im MediaStore finden (ab API 33 granular). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Direct-Backup (No-Copy): Originale per echtem Pfad lesen, um sie in place zu seeden
         (ohne 2×-Cache-Kopie). Opt-in; nur für „Direct backup" angefragt. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".BeamApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Beam">

        <!-- Haupt-Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:label="@string/app_name"
            android:theme="@style/Theme.Beam">

            <!-- App-Icon startet die App -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share-Intent: beliebige Datei(en) zum Senden entgegennehmen -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Magnetlink-Handler -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>

            <!-- .beam-Datei öffnen: lokale Dateien per Endung (Dateimanager, Downloads) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.beam" />
                <data android:pathPattern=".*\\..*\\.beam" />
                <data android:pathPattern=".*\\..*\\..*\\.beam" />
            </intent-filter>

            <!-- .beam-Datei öffnen: Messenger-Anhänge (content-URI ohne Endung im Pfad).
                 - application/x-beam: so taggt WhatsApp-DESKTOP die Datei (unsere Windows-MSI hat
                   .beam = application/x-beam registriert; der Typ reist mit der Nachricht zum Handy).
                 - application/octet-stream: so schickt Android-WhatsApp dieselbe Datei.
                 Beam prüft den Inhalt und ignoriert Nicht-Beam-Dateien. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/x-beam" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

        </activity>

        <!-- Seeding-Service läuft im Hintergrund -->
        <service
            android:name=".service.SeedingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider zum Öffnen empfangener Dateien (API < 29) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>