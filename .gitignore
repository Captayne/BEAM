# ── Build outputs (all Gradle modules) ───────────────────────────────
**/build/
/build
/captures
.externalNativeBuild
.cxx

# ── Gradle / Kotlin caches ───────────────────────────────────────────
.gradle/
.kotlin/

# ── IDE (Android Studio / IntelliJ) ──────────────────────────────────
/.idea/
*.iml

# ── Claude Code local settings (machine-specific) ────────────────────
.claude/settings.local.json

