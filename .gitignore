local.properties
/local.properties

# ── OS junk ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs / scratch ───────────────────────────────────────────────────
*.log

# ── Large vendored binaries & installers (NOT in version control) ────
#   Diese Dateien werden zum Bauen gebraucht, sind aber zu groß fürs Repo.
#   Bezugsquellen stehen in ARCHITECTURE.md (Abschnitt Build/Tooling).
#     - JDK-Installer (Temurin 21, ~171 MB) — nur lokal
/OpenJDK21U-*.msi
#     - WiX 3 Toolset (für jpackage/MSI) — nach tools/wix3/ entpacken
/tools/wix3/
#     - gebündeltes ffmpeg.exe (~97 MB) — gyan.dev essentials
/beam-desktop/desktop-resources/**/ffmpeg/ffmpeg.exe
#     - BBR-Test-Native (arm64 libtorrent4j.so, ~12 MB) — lokal/WSL gebaut, via -PbbrAndroid eingebunden
/app/src/bbr/
#     - BBR-Desktop-Native (torrent4j.dll, ~10 MB) — lokal gebaut (C:\l4j), via -PbbrDll ins MSI gebuendelt
/beam-desktop/src/bbr/

# SpliceTest-Artefakte (5MB-Binaerdateien)
beam-relay/splice-test/
memory/untitled.md
COMMIT_MSG.tmp
